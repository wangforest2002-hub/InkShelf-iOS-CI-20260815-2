[Unit]
Description=InkShelf social-media resolver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/opt/inkshelf-media
Environment=PYTHONUNBUFFERED=1
Environment=INKSHELF_MEDIA_PORT=8003
ExecStart=/usr/bin/python3.11 /opt/inkshelf-media/app.py
Restart=always
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
